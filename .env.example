# Email del formulario de contacto
# Destinatario de los mensajes del form
CONTACT_TO_EMAIL=samuelbermudez2812@gmail.com
# Nombre visible del remitente (opcional)
CONTACT_FROM_NAME=Portfolio samxssj

# --- Proveedor actual: Gmail SMTP ---
# Cuenta emisora dedicada (no la personal)
SMTP_USER=no.reply.samx@gmail.com
# Contraseña de aplicación de 16 caracteres (myaccount.google.com/apppasswords, requiere 2FA).
# NUNCA la contraseña real de la cuenta. Los espacios se ignoran.
SMTP_PASS=
# Opcionales: por defecto smtp.gmail.com:465 (TLS implícito)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Opcional: Resend (si se define, tiene prioridad y Gmail queda de fallback) ---
# RESEND_API_KEY=
# Remitente verificado en Resend (sin dominio propio: onboarding@resend.dev)
# CONTACT_FROM_EMAIL=onboarding@resend.dev
